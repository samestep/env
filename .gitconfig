[alias]
	adog = log --all --date-order --oneline --graph
	bdog = log --branches --date-order --oneline --graph
	dog = log --date-order --oneline --graph
	root = rev-parse --show-toplevel
[core]
	editor = vim
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[init]
	defaultBranch = main
[pull]
	ff = only
[user]
	email = sam@samestep.com
	name = Sam Estep
	signingkey = 2B42037F
