+// The handful of GGUF key-values that deciding a model's capabilities depends
+// on. Reading them means parsing the metadata block, which for a 27B model is
+// ~35 MB of key-values -- and a chat request asks twice, once directly and once
+// through CheckCapabilities in scheduleRunner, on top of GetModel's own read.
+// That was ~150 ms spent before inference was even scheduled, on every request,
+// for a model already resident in VRAM.
+//
+// Cached on the blob path, which is a content hash: what is at one can never
+// change, so there is nothing to invalidate. Note that this caches the *file
+// contents*, not the capabilities derived from them -- those also depend on
+// OLLAMA_GO_TEMPLATE and on the model's own config, and must still be worked
+// out each time.
+type ggufFacts struct {
+	arch         string
+	chatTemplate string
+	hasPooling   bool
+	hasVision    bool
+	hasAudio     bool
+}
+
+var ggufFactsCache sync.Map // blob path -> ggufFacts
+
+func ggufFactsOf(f *gguf.File) ggufFacts {
+	return ggufFacts{
+		arch:         f.KeyValue("general.architecture").String(),
+		chatTemplate: f.KeyValue("tokenizer.chat_template").String(),
+		hasPooling:   f.KeyValue("pooling_type").Valid(),
+		hasVision:    f.KeyValue("vision.block_count").Valid(),
+		hasAudio:     f.KeyValue("audio.block_count").Valid(),
+	}
+}
+
+func ggufFactsAt(path string) (ggufFacts, error) {
+	if cached, ok := ggufFactsCache.Load(path); ok {
+		return cached.(ggufFacts), nil
+	}
+
+	f, err := gguf.Open(path)
+	if err != nil {
+		return ggufFacts{}, err
+	}
+	defer f.Close()
+
+	facts := ggufFactsOf(f)
+	ggufFactsCache.Store(path, facts)
+	return facts, nil
+}
+
