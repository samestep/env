 @"gtk-tabs-location": GtkTabsLocation = .top,
 
+/// If true, tab overview thumbnails will update in real-time.
+///
+/// By default, libadwaita updates the thumbnail for the selected tab while
+/// keeping other tab thumbnails static until they are selected. Enabling this
+/// makes all thumbnails live, which is useful for monitoring multiple active
+/// terminals from the tab overview, but may increase CPU/GPU usage with many
+/// busy tabs.
+@"gtk-tab-overview-live-thumbnails": bool = false,
+
 /// If this is `true`, the titlebar will be hidden when the window is maximized,
