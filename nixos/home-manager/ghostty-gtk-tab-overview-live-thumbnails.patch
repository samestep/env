+    fn setTabPageLiveThumbnail(_: *Self, page: *adw.TabPage, live: bool) void {
+        var value = gobject.ext.Value.newFrom(live);
+        defer value.unset();
+
+        gobject.Object.setProperty(
+            page.as(gobject.Object),
+            "live-thumbnail",
+            &value,
+        );
+    }
+
+    fn syncTabOverviewLiveThumbnails(self: *Self) void {
+        const priv = self.private();
+        const config = if (priv.config) |v| v.get() else return;
+
+        const n = priv.tab_view.getNPages();
+        assert(n >= 0);
+
+        for (0..@intCast(n)) |i| {
+            const page = priv.tab_view.getNthPage(@intCast(i));
+            self.setTabPageLiveThumbnail(
+                page,
+                config.@"gtk-tab-overview-live-thumbnails",
+            );
+        }
+    }
+
