+def take_complete_sentences(buffer: str) -> tuple[list[str], str]:
+    """Split off the sentences that are finished, keeping the rest buffered.
+
+    Streaming synthesis needs to start speaking before the text has finished
+    arriving, but only on sentences it will not have to revise. Everything up to
+    the last sentence-ending punctuation is safe to synthesise; the remainder
+    stays until more text arrives or the stream ends.
+    """
+    matches = list(re.finditer(r'[.!?](?=\s|$)', buffer))
+    if not matches:
+        return [], buffer
+    cut = matches[-1].end()
+    return split_into_sentences(buffer[:cut]), buffer[cut:]
+
